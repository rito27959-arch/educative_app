---
// La page d'accueil de Kunfox.
import Base from '../layouts/Base.astro';
import Renard from '../components/Renard.astro';
import Telephone from '../components/Telephone.astro';
import Nav from '../components/Nav.astro';
import Pied from '../components/Pied.astro';
import RiveAnim from '../components/RiveAnim.astro';
import Kabi from '../components/Kabi.astro';
import CouleursKabi from '../components/CouleursKabi.astro';

const depot = 'https://github.com/rito27959-arch/educative_app/releases/latest/download';

// La carte des leçons : un type par pastille, et son Kabi (comme dans l'app).
const noeuds = [
  { nom: 'Découverte', ico: '✨', c: '#FF6B2B', dx: 0, pose: 1, mood: 1, kabi: 'droite' },
  { nom: 'Leçon', ico: '⭐', c: '#1FA971', dx: 70, pose: 19, mood: 0, kabi: 'gauche' },
  { nom: 'En image', ico: '📈', c: '#2F80ED', dx: 0, pose: 22, mood: 1, kabi: 'gauche' },
  { nom: 'Entraînement', ico: '🏋️', c: '#8B5CF6', dx: -70, pose: 6, mood: 2, kabi: 'droite' },
  { nom: 'Trophée', ico: '🏆', c: '#E5A400', dx: 0, pose: 16, mood: 2, kabi: 'droite', trophee: true },
].map((n, i) => ({ ...n, x: 170 + n.dx, y: 60 + i * 130 }));
const trace = noeuds.map((n, i) => (i === 0 ? `M${n.x} ${n.y}` : `Q${(noeuds[i - 1].x + n.x) / 2 + (n.dx === 0 ? noeuds[i - 1].dx : n.dx) * .6} ${(noeuds[i - 1].y + n.y) / 2} ${n.x} ${n.y}`)).join(' ');
const parMatiere = [
  ['Maths', 19, 0, 'Il réfléchit avec toi.'],
  ['Physique', 11, 2, 'Il se met en garde : place aux forces !'],
  ['Chimie', 20, 5, 'Il hausse les épaules… la réaction surprend.'],
  ['SVT', 10, 1, 'Il s\'étire, le corps humain au programme.'],
  ['Informatique', 18, 2, 'Il court sur place, comme un processeur.'],
  ['Langues', 26, 1, 'Il tend l\'oreille.'],
  ['Philosophie', 28, 0, 'Bras croisés, il pèse chaque argument.'],
  ['Histoire-Géo', 21, 1, 'Il te montre la carte.'],
] as const;
const tableMatieres = Object.fromEntries(parMatiere.map(([, pose, mood], i) => [i, { pose, mood }]));

const matieres = ['Mathématiques', 'Physique', 'Chimie', 'SVT', 'Informatique', 'Français', 'Anglais', 'Philosophie', 'Histoire-Géographie'];
---
<Base
  titre="Kunfox — Révise. Progresse. Monte."
  description="Kunfox, l'app qui t'aide à réviser chaque jour : leçons courtes, quiz qui expliquent tes erreurs, séries, ligues, et tout fonctionne sans Internet."
>
  <!-- L'animation d'entrée : le renard apparaît, sa toque tombe, il cligne
       des yeux, puis le nom glisse de derrière lui. Un clic la passe. -->
  <div class="intro" id="intro" aria-hidden="true">
    <div class="intro-marque">
      <Renard taille={120} class="intro-icone" />
      <div class="intro-mot">{'Kunfox'.split('').map((l, i) => <span style={`--i:${i}`}>{l}</span>)}</div>
    </div>
  </div>

  <Nav />

  <main>
    <section class="heros" id="heros">
      <div class="conteneur heros-grille">
        <div>
          <span class="pastille apres" style="--d:.1s">🐂 Ton coach de révision</span>
          <h1>
            <span class="ligne"><span style="--d:.15s">Révise.</span></span>
            <span class="ligne"><span style="--d:.28s">Progresse.</span></span>
            <span class="ligne"><span class="accent" style="--d:.41s">Monte.</span></span>
          </h1>
          <p class="chapo apres" style="--d:.6s">Des leçons de cinq minutes, des quiz qui t'expliquent chaque erreur, et Kabi, ta mascotte, qui t'encourage tous les jours. Même sans Internet.</p>
          <div class="heros-actions apres" style="--d:.72s">
            <a class="btn" href="#telecharger">Télécharger l'app</a>
            <a class="btn-2" href="#comment">Voir comment ça marche ↓</a>
          </div>
          <p class="heros-note apres" style="--d:.84s">Gratuit · Fonctionne hors ligne · Pensé pour les petits téléphones</p>
          <p class="heros-couleurs-titre apres" style="--d:.9s">Choisis la couleur de Kabi :</p>
          <CouleursKabi class="heros-couleurs apres" />
        </div>
        <div class="heros-visuel">
          <Telephone ecran="quiz" />
          <div class="bulle b1 apres" style="--d:1.1s">🔥 12 jours de suite</div>
          <div class="bulle b2 apres" style="--d:1.25s">✓ +10 XP</div>
          <!-- Kabi en vrai (le même fichier Rive que l'app) : il salue au
               survol et saute de joie quand on le touche. -->
          <Kabi valeur={0} survol={5} clic={1}
            largeur={170} class="renard-guet apres" label="Kabi, la mascotte de Kunfox. Touche-le !" />
        </div>
      </div>
    </section>

    <div class="ruban" aria-label="Matières">
      <div class="ruban-piste">
        {[...matieres, ...matieres].map((m) => <span>{m}</span>)}
      </div>
    </div>

    <section class="manifeste">
      <div class="conteneur">
        <h2 class="apparait">Cinq minutes par jour.<br /><span>C'est tout ce qu'il faut.</span></h2>
        <div class="chiffres">
          <div class="chiffre apparait" style="--d:.05s"><b data-compte="290">290</b><span>leçons et plus</span></div>
          <div class="chiffre apparait" style="--d:.15s"><b data-compte="5">5</b><span>minutes par leçon</span></div>
          <div class="chiffre apparait" style="--d:.25s"><b data-compte="0">0</b><span>Mo d'Internet nécessaires</span></div>
        </div>
      </div>
    </section>

    <!-- Trois promesses, trois illustrations vivantes qui démarrent en
         arrivant à l'écran, texte et image en alternance. -->
    <section class="promesses">
      <div class="conteneur">
        <div class="promesse apparait">
          <div class="promesse-visuel">
            <Kabi valeur={0} vue={3} clic={1} largeur={260} label="Kabi réfléchit avec toi" />
          </div>
          <div>
            <span class="pastille">Comme un jeu</span>
            <h2>Réviser, ça se joue.</h2>
            <p>Des questions courtes, des réponses qui claquent, Kabi qui réagit à chacune. On enchaîne sans voir le temps passer.</p>
          </div>
        </div>
        <div class="promesse inverse apparait">
          <div class="promesse-visuel">
            <RiveAnim src="kunfox_flamme" machine="Flamme" entree="allumee" valeur={0} vue={1}
              largeur={220} hauteur={250} label="La flamme de série qui s'allume" />
          </div>
          <div>
            <span class="pastille">Chaque jour</span>
            <h2>Ta flamme, ta fierté.</h2>
            <p>Une leçon par jour allume ta flamme. Elle grandit avec ta série, et elle te rappelle de revenir demain.</p>
          </div>
        </div>
        <div class="promesse apparait">
          <div class="promesse-visuel">
            <RiveAnim src="kunfox_reussite" machine="Reussite" largeur={240} hauteur={240} label="Bonne réponse !" />
          </div>
          <div>
            <span class="pastille">Vraiment utile</span>
            <h2>Chaque erreur te fait grandir.</h2>
            <p>Kunfox t'explique pourquoi, puis te repose la question à la fin de la leçon. Ce qu'on a raté une fois, on le retient pour de bon.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="comment">
      <div class="conteneur">
        <div class="titre-section apparait">
          <span class="pastille">Comment ça marche</span>
          <h2>Apprendre devient<br />une habitude.</h2>
          <p>Trois gestes, chaque jour. Kabi s'occupe du reste.</p>
        </div>
        <div class="recit">
          <div class="recit-tel"><Telephone ecran="lecon" class="tel-recit" /></div>
          <div>
            <div class="etape" data-ecran="lecon">
              <span class="num">1</span>
              <h3>Une leçon courte.</h3>
              <p>Chaque notion tient en quelques minutes, avec l'essentiel, un exemple et rien de plus. On avance sans se noyer.</p>
            </div>
            <div class="etape" data-ecran="quiz">
              <span class="num">2</span>
              <h3>Un quiz qui explique.</h3>
              <p>Une erreur n'est pas une sanction : Kunfox te montre tout de suite pourquoi, et te reposera la question plus tard.</p>
            </div>
            <div class="etape" data-ecran="serie">
              <span class="num">3</span>
              <h3>Une série qui grandit.</h3>
              <p>Chaque jour de révision allume ta flamme. Tu gagnes de l'expérience, tu montes de niveau, et ça se voit.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="carte">
      <div class="conteneur">
        <div class="carte-sec">
          <div class="apparait">
            <span class="pastille">🐂 Avec Kabi</span>
            <h2>Ta carte.<br />Ton chemin.</h2>
            <p>Les leçons s'enchaînent sur une carte, unité après unité. À chaque type de leçon, Kabi t'attend dans une pose différente — et il dort devant les unités que tu n'as pas encore ouvertes.</p>
            <ul class="types">
              <li><span class="rond" style="--c:#FF6B2B">✨</span><div><b>Découverte</b><span>La première leçon d'une unité. Kabi te fait coucou.</span></div></li>
              <li><span class="rond" style="--c:#1FA971">⭐</span><div><b>Leçon</b><span>Kabi prend la pose de ta matière.</span></div></li>
              <li><span class="rond" style="--c:#2F80ED">📈</span><div><b>En image</b><span>Courbes, tableaux, formules : Kabi te les présente.</span></div></li>
              <li><span class="rond" style="--c:#8B5CF6">🏋️</span><div><b>Entraînement</b><span>La dernière avant l'épreuve. Kabi soulève de la fonte.</span></div></li>
              <li><span class="rond" style="--c:#E5A400">🏆</span><div><b>Trophée</b><span>L'épreuve de l'unité : Kabi boxe, puis pose fièrement.</span></div></li>
            </ul>
          </div>
          <div class="chemin apparait" style="--d:.1s" aria-label="Exemple de carte des leçons">
            <svg class="trace" width="340" height="650" viewBox="0 0 340 650" aria-hidden="true">
              <path d={trace} fill="none" stroke="var(--bord)" stroke-width="10" stroke-linecap="round" stroke-dasharray="2 22" />
            </svg>
            {noeuds.map((n) => (
              <>
                <span class:list={['noeud', { trophee: n.trophee }]} style={`left:${n.x}px;top:${n.y}px;--c:${n.c}`}>{n.ico}<small>{n.nom}</small></span>
                <div class="kabi-noeud" style={`left:${n.kabi === 'droite' ? n.x + 44 : n.x - 156}px;top:${n.y - 100}px`}>
                  <Kabi pose={n.pose} expression={n.mood} largeur={110} label={`Kabi, leçon ${n.nom}`} />
                </div>
              </>
            ))}
          </div>
        </div>

        <div class="matieres-kabi apparait">
          <Kabi id="kabi-matiere" table={tableMatieres} valeur={0} largeur={170} label="Kabi, selon la matière" />
          <div>
            <h3>Et il change avec ta matière.</h3>
            <p>Touche une matière pour voir Kabi s'y mettre.</p>
            <div class="puces-matieres" role="group" aria-label="Matières">
              {parMatiere.map(([nom, , , legende], i) => (
                <button type="button" data-matiere={i} data-legende={legende} aria-pressed={i === 0 ? 'true' : 'false'}>{nom}</button>
              ))}
            </div>
            <p class="legende" id="legende-matiere" aria-live="polite">{parMatiere[0][3]}</p>
          </div>
        </div>
      </div>
    </section>

    <section id="fonctions">
      <div class="conteneur">
        <div class="titre-section apparait">
          <span class="pastille">Tout ce qu'il faut</span>
          <h2>Une app. Toutes tes révisions.</h2>
        </div>
        <div class="bento">
          <div class="carte c-large apparait"><span class="ico">📚</span><h3>Le programme, chapitre par chapitre</h3><p>Leçons, exercices corrigés et examens de fin de chapitre, rangés comme en classe.</p></div>
          <div class="carte c-petit apparait" style="--d:.08s"><span class="ico">🔥</span><h3>Séries</h3><p>Un jour, puis deux, puis cent.</p></div>
          <div class="carte c-moy c-ligues apparait"><span class="ico">🏆</span><h3>Ligues</h3><p>Grimpe le classement avec ceux qui révisent comme toi.</p><div class="podium"><i>2</i><i>1</i><i>3</i></div></div>
          <div class="carte c-moy apparait" style="--d:.08s"><span class="ico">🧠</span><h3>Cartes mentales</h3><p>Toute une leçon d'un seul coup d'œil, pour réviser la veille.</p></div>
          <div class="carte c-petit apparait"><span class="ico">🐂</span><h3>Kabi réagit</h3><p>Il saute de joie ou t'encourage, à chaque réponse.</p></div>
          <div class="carte c-large apparait" style="--d:.08s"><span class="ico">🔔</span><h3>Des rappels qui tombent juste</h3><p>Kunfox apprend l'heure à laquelle tu révises et te fait signe au bon moment, et le soir si ta série est en danger. Jamais plus.</p></div>
        </div>
      </div>
    </section>

    <section id="hors-ligne">
      <div class="conteneur">
        <div class="bande apparait">
          <div>
            <span class="pastille">Mode avion compris</span>
            <h2>Même sans Internet.<br />Même sans forfait.</h2>
            <p>Tout le contenu est déjà dans l'app. Pas de réseau au village, pas de crédit en fin de mois : tu révises quand même, partout.</p>
          </div>
          <div class="bande-visuel"><Telephone ecran="hors-ligne" /></div>
        </div>
      </div>
    </section>

    <section id="droplet">
      <div class="conteneur">
        <div class="droplet apparait">
          <span class="goutte" aria-hidden="true">
            <svg width="56" height="56" viewBox="0 0 64 64"><path d="M26.16 48.79A20 20 0 1 0 15.68 40L12.5 52.5Z" fill="none" stroke="#fff" stroke-width="5.2" stroke-linejoin="round" /><path d="M33 17.5C37.2 23 41.3 27 41.3 32.4a8.3 8.3 0 0 1-16.6 0C24.7 27 28.8 23 33 17.5Z" fill="#fff" /></svg>
          </span>
          <div>
            <h3>Révisez ensemble sur Droplet.</h3>
            <p>Pour discuter d'un exercice, partager une fiche ou réviser en groupe, Kunfox s'ouvre sur Droplet, la messagerie qui fonctionne même sans Internet, de téléphone à téléphone.</p>
            <a class="btn-2" href="https://dropletmesh.app" rel="noopener">Découvrir Droplet →</a>
          </div>
        </div>
      </div>
    </section>

    <section class="final" id="telecharger">
      <div class="conteneur">
        <div class="final-visuel apparait">
          <Kabi valeur={0} vue={4} clic={1} largeur={240} class="final-renard" label="Kabi fait la fête" />
        </div>
        <h2 class="apparait" style="--d:.08s">Prêt à monter ?</h2>
        <p class="apparait" style="--d:.16s">Kunfox est gratuit, pour Android.</p>
        <div class="telechargements apparait" style="--d:.24s">
          <a class="btn" href={`${depot}/Kunfox-arm64-v8a.apk`} download>Télécharger pour Android</a>
          <p class="autres">
            Téléphone ancien ou d'entrée de gamme ? <a href={`${depot}/Kunfox-armeabi-v7a.apk`} download>Version armeabi-v7a</a>
            · Émulateur ou tablette x86 : <a href={`${depot}/Kunfox-x86_64.apk`} download>x86_64</a>
          </p>
          <p class="autres">Toutes les versions et leurs empreintes sont sur <a href="https://github.com/rito27959-arch/educative_app/releases" rel="noopener">GitHub</a>.</p>
        </div>
      </div>
    </section>

    <!-- Barre d'action qui apparaît une fois le haut de page dépassé. -->
    <div class="barre-cta" id="barre-cta" aria-hidden="true">
      <span>🐂 Révise chaque jour avec Kunfox</span>
      <a class="btn" href="#telecharger" tabindex="-1">Télécharger</a>
    </div>
  </main>

  <Pied />

  <script>
    import '../scripts/rive';
    const reduit = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const heros = document.getElementById('heros')!;
    const intro = document.getElementById('intro')!;

    // ── L'animation d'entrée : une fois par visite, passable d'un clic.
    let dejaVue = false;
    try { dejaVue = sessionStorage.getItem('kunfox-intro') === '1'; } catch (e) {}
    const montrerPage = () => heros.classList.add('pret');
    if (reduit || dejaVue) {
      intro.remove();
      montrerPage();
    } else {
      let fini = false;
      const finir = () => {
        if (fini) return;
        fini = true;
        try { sessionStorage.setItem('kunfox-intro', '1'); } catch (e) {}
        intro.classList.add('part');
        setTimeout(montrerPage, 120);
        setTimeout(() => intro.remove(), 800);
      };
      requestAnimationFrame(() => intro.classList.add('joue'));
      setTimeout(finir, 2500);
      intro.addEventListener('click', finir);
    }

    // ── Apparition au défilement, et chiffres qui comptent.
    const compter = (el: HTMLElement) => {
      const cible = Number(el.dataset.compte);
      el.textContent = '0';
      const debut = performance.now();
      const pas = (t: number) => {
        const p = Math.min(1, (t - debut) / 1200);
        el.textContent = String(Math.round(cible * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(pas);
      };
      requestAnimationFrame(pas);
    };
    const obs = new IntersectionObserver((entrees) => {
      for (const e of entrees) {
        if (!e.isIntersecting) continue;
        e.target.classList.add('vu');
        e.target.querySelectorAll<HTMLElement>('[data-compte]').forEach(compter);
        obs.unobserve(e.target);
      }
    }, { threshold: 0.18 });
    document.querySelectorAll('.apparait').forEach((el) => obs.observe(el));

    // ── Le récit : l'écran du téléphone suit l'étape lue.
    const tel = document.querySelector<HTMLElement>('.tel-recit');
    const etapes = document.querySelectorAll<HTMLElement>('.etape');
    const obsEtapes = new IntersectionObserver((entrees) => {
      for (const e of entrees) {
        if (!e.isIntersecting) continue;
        etapes.forEach((x) => x.classList.toggle('active', x === e.target));
        if (tel) tel.dataset.ecran = (e.target as HTMLElement).dataset.ecran!;
      }
    }, { rootMargin: '-45% 0px -45% 0px' });
    etapes.forEach((el) => obsEtapes.observe(el));

    // ── La barre d'action : visible entre le haut de page et le bas.
    const barre = document.getElementById('barre-cta')!;
    const final = document.getElementById('telecharger')!;
    let hautPasse = false, basAtteint = false;
    const majBarre = () => {
      const vis = hautPasse && !basAtteint;
      barre.classList.toggle('vue', vis);
      barre.setAttribute('aria-hidden', String(!vis));
      barre.querySelector('a')!.tabIndex = vis ? 0 : -1;
    };
    new IntersectionObserver(([e]) => { hautPasse = !e.isIntersecting; majBarre(); }).observe(heros);
    new IntersectionObserver(([e]) => { basAtteint = e.isIntersecting; majBarre(); }).observe(final);
  </script>
  <script>
    // Les puces des matières : Kabi prend la pose de la matière touchée.
    const kabi = document.getElementById('kabi-matiere') as HTMLCanvasElement | null;
    const legende = document.getElementById('legende-matiere');
    document.querySelectorAll<HTMLButtonElement>('[data-matiere]').forEach((b) => b.addEventListener('click', () => {
      const v = Number(b.dataset.matiere);
      document.querySelectorAll('[data-matiere]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      if (legende) legende.textContent = b.dataset.legende ?? '';
      if (kabi) { kabi.dataset.valeur = String(v); kabi.dispatchEvent(new CustomEvent('kabi-valeur', { detail: v })); }
    }));
  </script>
</Base>
