---
// Une animation Rive de Kunfox (les mêmes fichiers que l'app), qui ne se
// charge et ne démarre qu'en arrivant à l'écran. Voir src/scripts/rive.ts.
interface Props {
  src: string;          // nom du fichier dans public/rive, sans .riv
  machine: string;      // machine à états
  entree?: string;      // entrée nombre à régler
  valeur?: number;      // sa valeur au départ
  vue?: number;         // sa valeur quand l'animation arrive à l'écran
  survol?: number;      // sa valeur au survol (puis retour à `valeur`)
  clic?: number;        // sa valeur au clic, pendant 2,4 s
  largeur: number;
  hauteur: number;
  class?: string;
  label: string;
  affiche?: string;     // image fixe (dans public/rive), sinon `${src}.svg`
  fixes?: Record<string, number | boolean>;          // entrées réglées une fois au chargement
  table?: Record<number, Record<string, number>>;    // une valeur → plusieurs entrées (Kabi : pose + expression)
  kabi?: boolean;       // suit la couleur de Kabi choisie sur la page
}
const { src, machine, entree, valeur, vue, survol, clic, largeur, hauteur, class: classe, label, affiche, fixes, table, kabi } = Astro.props;
---
<!-- L'image fixe reste visible tant que Rive n'a pas dessiné (navigateur
     sans WebAssembly, mode « économie de données », réseau lent). -->
<span class:list={['rive-cadre', classe]} style={`width:${largeur}px;aspect-ratio:${largeur}/${hauteur}`}>
  <img class="rive-affiche" src={`/rive/${affiche ?? src + '.svg'}`} alt="" aria-hidden="true" width={largeur} height={hauteur} loading="lazy" decoding="async" />
  <canvas
    class="rive"
    role="img"
    aria-label={label}
    width={largeur * 2}
    height={hauteur * 2}
    data-rive={src}
    data-machine={machine}
    data-entree={entree}
    data-valeur={valeur}
    data-vue={vue}
    data-survol={survol}
    data-clic={clic}
    data-fixes={fixes ? JSON.stringify(fixes) : undefined}
    data-table={table ? JSON.stringify(table) : undefined}
    data-kabi={kabi ? '1' : undefined}
  ></canvas>
</span>
